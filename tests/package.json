{
  "name": "erandel-tests",
  "private": true,
  "description": "Automated tests for Erandel (the src/ modules, joined by tools/build.js)",
  "scripts": {
    "test": "node --test \"unit/**/*.test.js\" integration/playthrough.test.js",
    "check:build": "node ../tools/build.js --check",
    "test:unit": "node --test \"unit/**/*.test.js\"",
    "test:playthrough": "node --test integration/playthrough.test.js",
    "test:browser": "node integration/browser-smoke.js",
    "test:p2p": "node integration/p2p-smoke.js",
    "test:save": "node integration/save-compat.js",
    "test:fallback": "node integration/fallback-smoke.js",
    "test:region": "node integration/region-erelian.js",
    "perf": "node integration/perf-probe.js"
  },
  "devDependencies": {
    "jsdom": "24.1.3",
    "puppeteer-core": "22.15.0",
    "three": "^0.151.0",
    "three-r128": "npm:three@^0.128.0",
    "three-r147": "npm:three@^0.147.0"
  }
}
